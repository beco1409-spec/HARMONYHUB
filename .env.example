# Copie este arquivo para ".env" e preencha com as credenciais do SEU
# projeto Supabase (Project Settings > API), NÃO as do projeto antigo
# gerenciado pela Lovable.

SUPABASE_PROJECT_ID="seu-project-id"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxxxxxxxxxxxxxxxxxxx"
SUPABASE_URL="https://seu-project-id.supabase.co"

VITE_SUPABASE_PROJECT_ID="seu-project-id"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxxxxxxxxxxxxxxxxxxx"
VITE_SUPABASE_URL="https://seu-project-id.supabase.co"

# Somente para uso no servidor (server functions com service role) — NUNCA
# prefixe com VITE_ e nunca exponha ao cliente.
SUPABASE_SERVICE_ROLE_KEY="sb_secret_xxxxxxxxxxxxxxxxxxxx"
